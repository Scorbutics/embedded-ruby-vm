# Kotlin/Native cinterop definition for Ruby VM
# This file tells K/N which C headers to use for static library linking

package = com.scorbutics.rubyvm.native

# C headers to expose to Kotlin
# We expose:
#  - ruby-interpreter.h: Core interpreter functions
#  - ruby-script.h: Script management functions
#  - log-listener.h: Logging callback types
#  - completion-task.h: Completion callback types
#  - ruby-script-location.h: Script location types
#  - assets-install.h: For assets extraction and path management
#  - assets-error.h: For error handling in assets operations
headers = embedded-ruby-vm/ruby-interpreter.h embedded-ruby-vm/ruby-script.h embedded-ruby-vm/log-listener.h embedded-ruby-vm/completion-task.h embedded-ruby-vm/ruby-script-location.h embedded-ruby-vm/assets-install.h embedded-ruby-vm/assets-error.h

# Filter which headers are processed (allow all from ruby-vm and assets directories)
# IMPORTANT: Include both static/ and shared/ subdirectories so cinterop can process them
headerFilter = ruby-api-loader.h static/ruby-api-loader.h shared/ruby-api-loader.h embedded-ruby-vm/log-listener.h embedded-ruby-vm/completion-task.h embedded-ruby-vm/ruby-script-location.h embedded-ruby-vm/ruby-interpreter.h embedded-ruby-vm/ruby-script.h embedded-ruby-vm/assets-install.h embedded-ruby-vm/assets-error.h

# Compiler options for finding headers
# NOTE: Include paths are configured in build.gradle.kts via includeDirs.headerFilterOnly()
# This ensures absolute paths are used and avoids path resolution issues

# Linker options for static libraries
# NOTE: Static libraries and their paths are configured in build.gradle.kts
# via extraOpts for platform-specific linking

