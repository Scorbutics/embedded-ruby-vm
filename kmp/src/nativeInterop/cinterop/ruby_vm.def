# Kotlin/Native cinterop definition for Ruby VM
# This file tells K/N which C headers to use for dynamic library loading

package = com.scorbutics.rubyvm.native

# C headers to expose to Kotlin
# We expose:
#  - ruby-api-loader.h: For dynamic library loading (includes RubyCompletionTask helpers and deps loading)
#  - install.h: For assets extraction and path management
#  - assets-error.h: For error handling in assets operations
headers = ruby-api-loader.h install.h assets-error.h

# Filter which headers are processed
headerFilter = ruby-api-loader.h install.h assets-error.h

# Compiler options for finding headers
# NOTE: Include paths are configured in build.gradle.kts via includeDirs.headerFilterOnly()
# This ensures absolute paths are used and avoids path resolution issues

# IMPORTANT: No linker options are specified here!
# The ruby-api-loader.h approach uses dlopen() to load libembedded-ruby at runtime,
# so we do NOT link against it at build time. This allows the library to be
# extracted by libassets.a and loaded dynamically after deployment.

